{"$id": "yggdrasil/contracts/v1/liveness_report", "$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"at": {"format": "date-time", "type": "string"}, "beats_accepted": {"minimum": 0, "type": "integer"}, "beats_duplicate": {"minimum": 0, "type": "integer"}, "beats_refused": {"minimum": 0, "type": "integer"}, "gone_count": {"minimum": 0, "type": "integer"}, "observer_node_id": {"pattern": "^[a-z0-9][a-z0-9-]{1,62}$", "type": "string"}, "peers": {"items": {"$ref": "liveness_record.schema.json"}, "type": "array"}, "policy": {"$ref": "liveness_policy.schema.json"}, "present_count": {"minimum": 0, "type": "integer"}, "refused_reasons": {"additionalProperties": {"minimum": 0, "type": "integer"}, "type": "object"}, "simulated": {"const": true}, "suspect_count": {"minimum": 0, "type": "integer"}, "transitions": {"minimum": 0, "type": "integer"}, "version": {"const": 1}}, "required": ["version", "at", "observer_node_id", "simulated", "policy", "peers", "present_count", "suspect_count", "gone_count", "beats_accepted", "beats_refused", "beats_duplicate", "refused_reasons", "transitions"], "title": "LivenessReport v1 \u2014 one liveness tracker's counted state: the ageing policy it judges by, every peer's verdict record, the present/suspect/gone counts, every heartbeat accepted, refused and why, duplicates counted apart, and the verdict transitions its sweeps have recorded \u2014 names and counts only (Y-054)", "type": "object"}