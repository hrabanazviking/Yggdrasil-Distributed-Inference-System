{"$id": "yggdrasil/contracts/v1/liveness_record", "$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"age_seconds": {"minimum": 0, "type": "number"}, "basis": {"enum": ["fresh", "silence", "self_reported_gone"], "type": "string"}, "beats_accepted": {"minimum": 1, "type": "integer"}, "gone_after_seconds": {"minimum": 3, "type": "integer"}, "last_beat_at": {"format": "date-time", "type": "string"}, "last_seen_at": {"format": "date-time", "type": "string"}, "last_seq": {"minimum": 0, "type": "integer"}, "missed_beats": {"minimum": 0, "type": "integer"}, "node_id": {"pattern": "^[a-z0-9][a-z0-9-]{1,62}$", "type": "string"}, "simulated": {"const": true}, "suspect_after_seconds": {"minimum": 2, "type": "integer"}, "verdict": {"enum": ["present", "suspect", "gone"], "type": "string"}, "version": {"const": 1}}, "required": ["version", "node_id", "verdict", "basis", "last_seq", "last_beat_at", "last_seen_at", "age_seconds", "missed_beats", "suspect_after_seconds", "gone_after_seconds", "beats_accepted", "simulated"], "title": "LivenessRecord v1 \u2014 one observer's ageing verdict on one peer: present, suspect, or gone, and on what basis (a fresh heartbeat, silence past the policy's lines, or the peer's own gone heartbeat); the last accepted beat's sequence and moment, when it was last heard on the observer's own clock, the measured silence since, the beats that silence has swallowed at the policy's expected interval, and the policy lines the verdict was aged against (Y-054)", "type": "object"}