{"$id":"yggdrasil/contracts/v1/discovery_peer","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"device_class":{"enum":["pi","laptop","desktop","server","vm","phone","jetson","other"],"type":"string"},"expires_at":{"format":"date-time","type":"string"},"fingerprint":{"pattern":"^[0-9a-f]{64}$","type":"string"},"first_seen_at":{"format":"date-time","type":"string"},"host":{"maxLength":253,"minLength":1,"type":"string"},"last_seen_at":{"format":"date-time","type":"string"},"node_id":{"pattern":"^[a-z0-9][a-z0-9-]{1,62}$","type":"string"},"port":{"maximum":65535,"minimum":1,"type":"integer"},"seq":{"minimum":0,"type":"integer"},"simulated":{"const":true},"sources":{"items":{"enum":["mdns","seed"],"type":"string"},"minItems":1,"type":"array","uniqueItems":true},"transport":{"const":"tls"},"version":{"const":1}},"required":["version","node_id","fingerprint","device_class","host","port","transport","sources","seq","first_seen_at","last_seen_at","expires_at","simulated"],"title":"DiscoveryPeer v1 — one entry in a node's peer table: a peer whose Y-011 certificate verified, where it may be reached over TLS, how it was found (mdns and/or the seed list), and its freshness window — first seen, last seen, and the moment the entry expires, all on the hearing node's own clock (Y-052)","type":"object"}