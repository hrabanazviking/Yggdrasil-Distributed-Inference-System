{"$id":"yggdrasil/contracts/v1/clock_report","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"at":{"format":"date-time","type":"string"},"consensus_offset_seconds":{"type":["number","null"]},"judgements":{"minimum":0,"type":"integer"},"judgements_corrected":{"minimum":0,"type":"integer"},"nodes":{"items":{"additionalProperties":false,"properties":{"max_abs_skew_seconds":{"type":["number","null"]},"median_skew_seconds":{"type":["number","null"]},"node_id":{"pattern":"^[a-z0-9][a-z0-9-]{1,62}$","type":"string"},"observers":{"minimum":0,"type":"integer"},"samples":{"minimum":0,"type":"integer"},"trusted":{"type":"boolean"},"verdict":{"enum":["unknown","uncorroborated","trusted","skewed","severe"],"type":"string"}},"required":["node_id","samples","observers","median_skew_seconds","max_abs_skew_seconds","verdict","trusted"],"type":"object"},"type":"array"},"nodes_enrolled":{"minimum":0,"type":"integer"},"policy":{"$ref":"clock_policy.schema.json"},"records":{"items":{"$ref":"clock_record.schema.json"},"type":"array"},"refusals_by_reason":{"additionalProperties":{"minimum":0,"type":"integer"},"type":"object"},"samples_accepted":{"minimum":0,"type":"integer"},"severe_nodes":{"minimum":0,"type":"integer"},"simulated":{"const":true},"skewed_nodes":{"minimum":0,"type":"integer"},"trusted_nodes":{"minimum":0,"type":"integer"},"uncorroborated_nodes":{"minimum":0,"type":"integer"},"version":{"const":1}},"required":["version","at","simulated","policy","nodes","nodes_enrolled","samples_accepted","judgements","judgements_corrected","consensus_offset_seconds","trusted_nodes","skewed_nodes","severe_nodes","uncorroborated_nodes","refusals_by_reason","records"],"title":"ClockReport v1 — the clock watch at a moment: every enrolled node's standing (accepted samples, distinct observers, the median skew over each observer's latest vote, the largest absolute vote, and its verdict — unknown, uncorroborated, trusted, skewed, or severe — with