{"$id": "yggdrasil/contracts/v1/protocol_message", "$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"from_node": {"pattern": "^[a-z0-9][a-z0-9-]{1,62}$", "type": "string"}, "hop_limit": {"maximum": 255, "minimum": 1, "type": ["integer", "null"]}, "message_id": {"format": "uuid", "type": "string"}, "payload": {}, "priority": {"enum": ["normal", "high", null], "type": ["string", "null"]}, "protocol_version": {"maximum": 999, "minimum": 1, "type": "integer"}, "sent_at": {"format": "date-time", "type": "string"}, "simulated": {"const": true}, "to_node": {"pattern": "^[a-z0-9][a-z0-9-]{1,62}$", "type": "string"}, "version": {"const": 1}}, "required": ["version", "message_id", "from_node", "to_node", "protocol_version", "sent_at", "priority", "hop_limit", "payload", "simulated"], "title": "ProtocolMessage v1 \u2014 one direct node-to-node message judged by the versioned-protocol gate: the protocol version it claims, its two ends, the fields protocol v2 added (priority, hop_limit \u2014 null on a v1 message), and its payload whole; simulated is a constant \u2014 the gate judges in-process copies, not wire traffic (Y-065)", "type": "object"}