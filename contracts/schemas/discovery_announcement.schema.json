{"$id":"yggdrasil/contracts/v1/discovery_announcement","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"agent_version":{"minLength":1,"type":"string"},"announced_at":{"format":"date-time","type":"string"},"certificate":{"$ref":"node_certificate.schema.json"},"device_class":{"enum":["pi","laptop","desktop","server","vm","phone","jetson","other"],"type":"string"},"fingerprint":{"pattern":"^[0-9a-f]{64}$","type":"string"},"host":{"maxLength":253,"minLength":1,"type":"string"},"node_id":{"pattern":"^[a-z0-9][a-z0-9-]{1,62}$","type":"string"},"port":{"maximum":65535,"minimum":1,"type":"integer"},"seq":{"minimum":0,"type":"integer"},"simulated":{"const":true},"transport":{"const":"tls"},"version":{"const":1}},"required":["version","node_id","fingerprint","device_class","agent_version","certificate","host","port","transport","seq","announced_at","simulated"],"title":"DiscoveryAnnouncement v1 — one node's announcement as heard on the LAN: who it claims to be, the Y-011 node certificate that must prove it, the TLS endpoint it may be reached at (transport is always tls — discovery never yields a plaintext endpoint), and a per-node rising sequence; carried by the in-process simulated LAN in this slice, so simulated is always true (Y-052)","type":"object"}