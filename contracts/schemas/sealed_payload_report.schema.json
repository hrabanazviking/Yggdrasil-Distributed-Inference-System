{"$id":"yggdrasil/contracts/v1/sealed_payload_report","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"at":{"format":"date-time","type":"string"},"nodes":{"items":{"additionalProperties":false,"properties":{"node_id":{"pattern":"^[a-z0-9][a-z0-9-]{1,62}$","type":"string"},"public_key_fingerprint":{"pattern":"^[0-9a-f]{64}$","type":"string"},"sealed_received":{"minimum":0,"type":"integer"},"sealed_sent":{"minimum":0,"type":"integer"}},"required":["node_id","public_key_fingerprint","sealed_sent","sealed_received"],"type":"object"},"type":"array"},"nodes_enrolled":{"minimum":0,"type":"integer"},"payloads_sealed":{"minimum":0,"type":"integer"},"plain_accepted":{"minimum":0,"type":"integer"},"policy":{"$ref":"sealed_payload_policy.schema.json"},"records":{"items":{"$ref":"sealed_payload_record.schema.json"},"type":"array"},"refusals_by_reason":{"additionalProperties":{"minimum":0,"type":"integer"},"type":"object"},"simulated":{"const":true},"version":{"const":1}},"required":["version","at","simulated","policy","nodes","nodes_enrolled","payloads_sealed","plain_accepted","refusals_by_reason","records"],"title":"SealedPayloadReport v1 — the sealing door at a moment: every enrolled node (its sealing key named only by SHA-256 fingerprint, how many payloads it sealed and how many were sealed to it), the totals (payloads sealed, plain carriages accepted for non-sensitive kinds), every refusal counted apart by name, and every act's record; simulated is a constant — sealing is proven in-process, no socket was opened and no LAN crossed, and no content, ciphertext, or key material stands in a report (Y-070)","type":"object"}