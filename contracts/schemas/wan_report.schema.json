{"$id":"yggdrasil/contracts/v1/wan_report","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"at":{"format":"date-time","type":"string"},"attempts":{"minimum":0,"type":"integer"},"delivered":{"minimum":0,"type":"integer"},"dropped":{"minimum":0,"type":"integer"},"dropped_reasons":{"additionalProperties":{"minimum":0,"type":"integer"},"type":"object"},"links":{"items":{"additionalProperties":false,"properties":{"attempts":{"minimum":0,"type":"integer"},"delivered":{"minimum":0,"type":"integer"},"dropped":{"minimum":0,"type":"integer"},"from_node":{"type":"string"},"max_latency_ms":{"minimum":0,"type":["number","null"]},"mean_latency_ms":{"minimum":0,"type":["number","null"]},"retries":{"minimum":0,"type":"integer"},"sent":{"minimum":0,"type":"integer"},"to_node":{"type":"string"}},"required":["from_node","to_node","sent","delivered","dropped","attempts","retries","mean_latency_ms","max_latency_ms"],"type":"object"},"type":"array"},"profile":{"$ref":"wan_profile.schema.json"},"records":{"items":{"$ref":"wan_record.schema.json"},"type":"array"},"seed":{"type":"integer"},"sent":{"minimum":0,"type":"integer"},"simulated":{"const":true},"version":{"const":1}},"required":["version","at","simulated","seed","profile","links","records","sent","delivered","dropped","attempts","dropped_reasons"],"title":"WanReport v1 — one WAN-shaped simulation at a moment: the seed and profile every crossing was shaped under, a per-directed-link standing (messages sent, delivered, and dropped, attempts spent and retries among them, and the mean and maximum simulated latency of delivered messages, null where nothing was delivered), every crossing record in order, and the counted totals with drops counted apart by named reason; simulated is a constant — every number here is a shape's consequence on a seeded draw, never a measurement of a real network (Y-063)","type":"object"}